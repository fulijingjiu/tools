{
  "name": "my-tools-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:pages": "vue-tsc -b && vite build --base=/tools/",
    "preview": "vite preview",
    "check:tools": "node scripts/check-tools-metadata.mjs",
    "qa:loop5:search": "node scripts/loop5-search-smoke.mjs",
    "qa:loop5:ui": "node scripts/loop5-ui-guard.mjs",
    "qa:loop5:theme-order": "node scripts/loop5-theme-order-guard.mjs",
    "qa:loop5:compat": "node scripts/loop5-compat-guard.mjs",
    "qa:loop5": "npm run check:tools && npm run qa:loop5:search && npm run qa:loop5:ui && npm run qa:loop5:theme-order && npm run qa:loop5:compat && npm run build",
    "loop5:operator": "node scripts/loop5-operator.mjs"
  },
  "dependencies": {
    "@vueuse/core": "^14.3.0",
    "diff": "^9.0.0",
    "lucide-vue-next": "^0.577.0",
    "marked": "^18.0.6",
    "qrcode": "^1.5.4",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/diff": "^7.0.2",
    "@types/node": "^24.13.2",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.5.2",
    "postcss": "^8.5.19",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vue-tsc": "^3.3.5"
  }
}
